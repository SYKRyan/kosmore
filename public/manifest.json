{
  "manifest_version": 3,
  "name": "KosMore",
  "version": "2.0.62",
  "key": "",
  "description": "Card insights and pinned album shortcuts for Kosmora, including pack reveals and summaries.",
  "minimum_chrome_version": "120",
  "permissions": [
    "storage",
    "identity",
    "alarms",
    "declarativeNetRequestWithHostAccess"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "host_permissions": [
    "https://kosmora.io/*",
    "https://fpanbppeaofadlmpbdlhhdmbdopclckj.chromiumapp.org/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["link-complete.html"],
      "matches": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"]
    }
  ],
  "action": { "default_title": "KosMore settings" },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [
    {
      "matches": ["https://kosmora.io/*"],
      "js": ["page-hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://kosmora.io/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
